{
  "compilerOptions": {
    "outDir": "dist",
    "module": "es2022",
    "target": "es2017",
    "jsx": "react-jsx",
    "noEmitOnError": true,
    "noImplicitAny": true,
    "removeComments": true,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@axios/*": ["node_modules/axios/*"]
    },
    "lib": ["dom", "es2020"]
  },
  "include": ["src/**/*"]
}
